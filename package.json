{
  "name": "muleteer",
  "productName": "Muleteer",
  "version": "1.0.0",
  "description": "Muleteer — a media center for aMule: play your files and discover music and video from the network and other users",
  "main": "electron/main.js",
  "scripts": {
    "test": "node examples/test.js",
    "prestart": "node scripts/dev-brand.js",
    "start": "electron electron/main.js",
    "icon": "node scripts/build-icon.js",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "amule",
    "p2p",
    "ed2k",
    "media-center"
  ],
  "author": "tbo47",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tbo47.muleteer",
    "productName": "Muleteer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "AmuleClient.js",
      "ECDefs.js",
      "ECProtocol.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  }
}
